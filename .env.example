# Copy to .env. Read by src/transit/config.py via pydantic-settings.
DATABASE_URL=postgresql+psycopg://transit:transit@localhost:5432/transit

# Big Blue Bus feeds (public, no API key).
BBB_STATIC_URL=https://gtfs.bigbluebus.com/current.zip
BBB_TRIP_UPDATES_URL=https://gtfs.bigbluebus.com/tripupdates.bin
BBB_VEHICLE_POSITIONS_URL=https://gtfs.bigbluebus.com/vehiclepositions.bin

# Seconds between realtime polls.
POLL_INTERVAL_SECONDS=30

# A feed whose header timestamp is older than this is reported as stale.
FEED_STALE_AFTER_SECONDS=180
